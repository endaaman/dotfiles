#!/usr/bin/env python3
"""uvenv - 名前付きグローバル uv 環境マネージャ

pyenv-virtualenv の `pyenv activate <name>` 相当を uv で行う。
環境の実体は ~/.uvenvs/<name>/ で、それぞれが独立した uv プロジェクト。

activate / deactivate は現在のシェルを書き換える必要があるため、
このスクリプトではなく zshrc の uvenv() 関数が担当する。
ここは `path` を返すエンジンに徹する。
"""

import argparse
import os
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path


UVENVS_HOME = Path(os.environ.get("UVENVS_HOME", Path.home() / ".uvenvs"))


def die(msg):
    print(f"uvenv: {msg}", file=sys.stderr)
    sys.exit(1)


def read_pyproject(env_path):
    toml_path = env_path / "pyproject.toml"
    if not toml_path.exists():
        return None
    try:
        with open(toml_path, "rb") as f:
            return tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        return {"__error__": f"TOML parse error: {e}"}
    except OSError as e:
        return {"__error__": f"read error: {e}"}


def venv_dir(env_path, data=None):
    """venv の置き場を解決する。

    uv は既定で .venv を使うが [tool.uv] project-environment で変えられる。
    決め打ちにすると設定変更後に取り違えるのでここで解決する。
    優先順位は uv 本体と同じ: UV_PROJECT_ENVIRONMENT > pyproject > .venv
    """
    override = os.environ.get("UV_PROJECT_ENVIRONMENT")
    if override:
        return env_path / override
    if data is None:
        data = read_pyproject(env_path) or {}
    configured = data.get("tool", {}).get("uv", {}).get("project-environment")
    return env_path / (configured or ".venv")


def is_ready(path):
    return (path / "bin" / "activate").exists()


def list_envs():
    if not UVENVS_HOME.exists():
        return []
    return sorted(d for d in UVENVS_HOME.iterdir() if d.is_dir())


def require_env(name):
    env_path = UVENVS_HOME / name
    if not env_path.is_dir():
        available = ", ".join(p.name for p in list_envs()) or "(なし)"
        die(f"環境 '{name}' がありません。利用可能: {available}")
    return env_path


def active_name():
    """今 activate されている uvenv 名。無ければ None。"""
    current = os.environ.get("VIRTUAL_ENV")
    if not current:
        return None
    try:
        rel = Path(current).resolve().relative_to(UVENVS_HOME.resolve())
    except (ValueError, OSError):
        return None
    return rel.parts[0] if rel.parts else None


def uv(*args, **kwargs):
    if not shutil.which("uv"):
        die("uv が見つかりません")
    return subprocess.run(["uv", *args], **kwargs)


# ---------------------------------------------------------------- commands

def cmd_list(args):
    envs = list_envs()
    if not envs:
        print(f"環境がありません ({UVENVS_HOME})")
        return

    active = active_name()
    for env_path in envs:
        data = read_pyproject(env_path)
        vdir = venv_dir(env_path, data or {})
        ready = is_ready(vdir)

        if data is None:
            mark, note = "△", "pyproject.toml が無い (未初期化)"
        elif "__error__" in data:
            mark, note = "✗", data["__error__"]
        elif not ready:
            mark, note = "○", f"venv 未作成 ({vdir.name}) — uvenv sync {env_path.name}"
        else:
            mark, note = "✓", None

        cur = " *" if env_path.name == active else ""
        print(f"  {mark} {env_path.name}{cur}")

        if data and "__error__" not in data:
            project = data.get("project", {})
            deps = project.get("dependencies")
            print(f"      python: {project.get('requires-python', '-')}"
                  f"  deps: {len(deps) if deps is not None else '-'}"
                  f"  venv: {vdir.name}")
        if note:
            print(f"      ! {note}")

        # 設定と実体がずれている場合 (project-environment を後から変えた等)
        if ready is False and (env_path / ".venv" / "bin" / "activate").exists():
            print(f"      ! .venv が残っています。{vdir.name} とどちらを使うか確認してください")


def cmd_names(args):
    """補完用。1行1名前だけを出す。"""
    for env_path in list_envs():
        print(env_path.name)


def cmd_path(args):
    """activate 用に venv のパスだけを返す。zshrc の uvenv() が使う。"""
    env_path = require_env(args.name)
    vdir = venv_dir(env_path)
    if not is_ready(vdir):
        die(f"'{args.name}' の venv がまだありません → uvenv sync {args.name}")
    print(vdir)


def cmd_new(args):
    env_path = UVENVS_HOME / args.name
    if env_path.exists():
        die(f"'{args.name}' は既にあります: {env_path}")

    UVENVS_HOME.mkdir(parents=True, exist_ok=True)
    env_path.mkdir()

    init = ["init", "--bare", "--no-workspace", "--name", args.name]
    if args.python:
        init += ["--python", args.python]
    init += ["--directory", str(env_path)]
    if uv(*init).returncode != 0:
        die("uv init に失敗しました")

    if args.packages:
        if uv("add", "--directory", str(env_path), *args.packages).returncode != 0:
            die("uv add に失敗しました")
    else:
        uv("sync", "--directory", str(env_path))

    print(f"作成しました: {env_path}")
    print(f"  uvenv activate {args.name}")


def cmd_add(args):
    env_path = require_env(args.name)
    sys.exit(uv("add", "--directory", str(env_path), *args.packages).returncode)


def cmd_remove(args):
    env_path = require_env(args.name)
    if active_name() == args.name:
        die(f"'{args.name}' は現在 activate 中です。deactivate してから実行してください")
    if not args.yes:
        ans = input(f"{env_path} を削除します。よろしいですか (y/N): ")
        if ans.lower() not in ("y", "yes"):
            print("中止しました")
            return
    shutil.rmtree(env_path)
    print(f"削除しました: {env_path}")


def cmd_sync(args):
    env_path = require_env(args.name)
    sys.exit(uv("sync", "--directory", str(env_path)).returncode)


def cmd_run(args):
    """activate せずにその環境でコマンドを実行する。"""
    env_path = require_env(args.name)
    sys.exit(uv("run", "--directory", str(env_path), *args.command).returncode)


# ---------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(prog="uvenv", description="名前付きグローバル uv 環境")
    sub = p.add_subparsers(dest="command")

    s = sub.add_parser("list", aliases=["ls"], help="環境一覧")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("names", help="名前だけ出力 (補完用)")
    s.set_defaults(func=cmd_names)

    s = sub.add_parser("path", help="venv のパスを出力")
    s.add_argument("name")
    s.set_defaults(func=cmd_path)

    s = sub.add_parser("new", help="環境を作る")
    s.add_argument("name")
    s.add_argument("--python", help="Python バージョン (例: 3.11)")
    s.add_argument("packages", nargs="*", help="同時に入れるパッケージ")
    s.set_defaults(func=cmd_new)

    s = sub.add_parser("add", help="パッケージを追加")
    s.add_argument("name")
    s.add_argument("packages", nargs="+")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("sync", help="venv を作る/更新する")
    s.add_argument("name")
    s.set_defaults(func=cmd_sync)

    s = sub.add_parser("run", help="activate せずに実行")
    s.add_argument("name")
    s.add_argument("command", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_run)

    s = sub.add_parser("rm", aliases=["remove"], help="環境を削除")
    s.add_argument("name")
    s.add_argument("-y", "--yes", action="store_true", help="確認しない")
    s.set_defaults(func=cmd_remove)

    # activate / deactivate は zshrc の関数が処理する。
    # 素の実行に来た場合だけ案内する。
    for name in ("activate", "deactivate"):
        s = sub.add_parser(name, help="(zsh 関数が処理します)")
        s.add_argument("rest", nargs="*")
        s.set_defaults(func=lambda a, n=name: die(
            f"'{n}' は現在のシェルを変更するため zshrc の uvenv() 関数が処理します。\n"
            f"       関数が読み込まれていません (exec zsh で読み直してください)"))

    args = p.parse_args()
    if not args.command:
        p.print_help()
        sys.exit(1)
    args.func(args)


if __name__ == "__main__":
    main()
