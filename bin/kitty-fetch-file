#!/bin/bash
# ssh 先のファイルを手元の ~/Downloads/ へ取ってくる。パスは引数で受ける（hints で画面から選んだもの）。
#
# kitty.conf から hints 経由で `launch --type=overlay --allow-remote-control <this> <path>` として呼ぶ。
# 親（state:overlay_parent）の ssh の接続先から取る。
# 相対パスは ssh 先の tmux のカレントディレクトリ（無ければ $HOME）から解決する。
# 転送は rsync（別の ssh 接続）なので大きいファイルやディレクトリも取れる

set -uo pipefail

path=${1:?usage: kitty-fetch-file <remote-path>}
parent=state:overlay_parent
local_dir=$HOME/Downloads

pause() {
  echo
  read -rsn1 -p 'キーを押すと閉じます'
}

mapfile -t target < <(~/dotfiles/bin/kitty-ssh-target "$parent")
if [ ${#target[@]} -eq 0 ]; then
  echo 'このウィンドウでは ssh していません（手元の tmux の中から ssh している場合も同じ）'
  pause
  exit 1
fi
dest=${target[-1]}
opts=("${target[@]:0:${#target[@]}-1}")

# ssh 先で絶対パスにする。~ の展開もここで
resolve='cwd=$(tmux display -p "#{pane_current_path}" 2> /dev/null) || cwd=$HOME
cd "$cwd" 2> /dev/null || cd
p=$1
case $p in "~") p=$HOME ;; "~/"*) p=$HOME/${p#"~/"} ;; esac
realpath -e -- "$p"'
abs=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "${target[@]}" \
  "sh -c $(printf '%q' "$resolve") _ $(printf '%q' "$path")") || {
  echo "$dest に $path が見つかりませんでした"
  pause
  exit 1
}

mkdir -p "$local_dir"
echo "$dest:$abs → $local_dir/"
if ! rsync -aP --partial -e "ssh ${opts[*]}" -- "$dest:$abs" "$local_dir/"; then
  pause
  exit 1
fi

notify-send -a kitty 'kitty-fetch-file' "$local_dir/$(basename "$abs")"
