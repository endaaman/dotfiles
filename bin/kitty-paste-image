#!/bin/bash
# クリップボードの画像をファイルにして、そのパスを kitty のウィンドウへ貼る。
# ssh 先の Claude Code は手元のクリップボードを読めないので、画像を ssh 先へ送ってパスで渡す。
#
# kitty.conf から `launch --type=background --allow-remote-control <this> @active-kitty-window-id`
# で呼ぶ。KITTY_LISTEN_ON にこの起動専用の操作口が入るので、kitty 全体の遠隔操作は要らない。
#
# 送り先はウィンドウの前面プロセスで決める（bin/kitty-ssh-target）:
#   ssh が前面 → その ssh と同じ接続先の /tmp/kitty-paste/ へ送る
#   それ以外   → 手元の /tmp/kitty-paste/ に置く

set -uo pipefail

win=${1:?usage: kitty-paste-image <kitty-window-id>}
dir=/tmp/kitty-paste
name=clip-$(date +%Y%m%d-%H%M%S).png

fail() {
  notify-send -a kitty 'kitty-paste-image' "$1"
  exit 1
}

if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste > /dev/null; then
  wl-paste --list-types 2> /dev/null | grep -qx 'image/png' || fail 'クリップボードに PNG 画像がありません'
  img=$(mktemp) && trap 'rm -f "$img"' EXIT
  wl-paste --type image/png > "$img" || fail 'クリップボードを読めませんでした'
elif [ -n "${DISPLAY:-}" ] && command -v xclip > /dev/null; then
  xclip -selection clipboard -t TARGETS -o 2> /dev/null | grep -qx 'image/png' || fail 'クリップボードに PNG 画像がありません'
  img=$(mktemp) && trap 'rm -f "$img"' EXIT
  xclip -selection clipboard -t image/png -o > "$img" || fail 'クリップボードを読めませんでした'
else
  fail 'クリップボードを読む手段がありません（wl-paste / xclip）'
fi

if mapfile -t target < <(~/dotfiles/bin/kitty-ssh-target "id:$win") && [ ${#target[@]} -gt 0 ]; then
  ssh -o BatchMode=yes -o ConnectTimeout=5 "${target[@]}" \
    "mkdir -p $dir && cat > $dir/$name" < "$img" ||
    fail "${target[-1]} へ送れませんでした"
else
  mkdir -p "$dir"
  cp "$img" "$dir/$name" || fail "保存に失敗しました: $dir/$name"
fi

kitty @ send-text --match "id:$win" --bracketed-paste auto "$dir/$name"
